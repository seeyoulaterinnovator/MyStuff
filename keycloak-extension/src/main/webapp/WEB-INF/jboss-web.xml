<jboss-web>
    <resource-ref>
        <res-ref-name>infinispan/custom_container</res-ref-name>
        <lookup-name>java:jboss/infinispan/container/custom_container</lookup-name>
    </resource-ref>
    <resource-ref>
        <res-ref-name>infinispan/custom_container/user_post_cache</res-ref-name>
        <lookup-name>java:jboss/infinispan/cache/custom_container/user_post_cache</lookup-name>
    </resource-ref>
    <resource-ref>
        <res-ref-name>infinispan/custom_container/customer_cache</res-ref-name>
        <lookup-name>java:jboss/infinispan/cache/custom_container/customer_cache</lookup-name>
    </resource-ref>

    <!-- replication-config deprecated since WildFly 17 -->
    <replication-config>
        <replication-granularity>SESSION</replication-granularity>
    </replication-config>
</jboss-web>