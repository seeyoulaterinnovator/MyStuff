<#macro layout >
    <!DOCTYPE html>
    <html xmlns="http://www.w3.org/1999/xhtml" lang="ru">
    <head>
        <#include 'styles/template-style.html' >

        <#nested "style">
    </head>
    <body>
    <table class="mail-wrapper">
        <tr>
            <td>
                <table class="mail-container">
                    <tr>
                        <td>
                            <table margin="0" padding="0" cellpadding="0" cellspacing="0" class="mail-container__header"
                                   width="100%">
                                <tr>
                                    <td style="text-align: left;">
                                        <a href="https://newlkb2b.dom.ru" target="_blank" style="height: 0;">
                                            <img class="logo"
                                                 alt="ДОМ.РУ Бизнес"
                                                 height="48"
                                                 src="data:image/png;base64,"
                                            />
                                        </a>
                                    </td>
                                    <td style="text-align: right;">
                                        <table margin="0" padding="0" cellpadding="0" cellspacing="0"
                                               style="vertical-align: center; text-align: right; display: inline-table;">
                                            <tr>
                                                <td class="contact__number">
                                                    <a href="${phoneConstLink}" class="contacts">
                                                        ${phoneInMessage}
                                                    </a>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td align="right" class="system"><a href="https://newlkb2b.dom.ru"
                                                                                    class="system_link">lkb2b.dom.ru</a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <hr class="hr_color">


                            <div class="mail-container__content content">
                                <div class="content">
                                    <h2 class="content__heading">${customer}</h2>
                                    <#nested "body">
                                </div>
                            </div>

                            <div>
                                <p class="mail-text-title">Всегда на связи!</p>
                                <table class="messegers" cellpadding="0" cellspacing="0" width="100%">
                                    <tr height="140" valign="top">
                                        <td width="25%">
                                            <img width="120" height="120"
                                                 src="data:image/jpeg;base64,">
                                        </td>
                                        <td width="25%">
                                            <img width="120" height="120"
                                                 src="data:image/jpeg;base64,">
                                        </td>
                                        <td width="25%">
                                            <img width="120" height="120"
                                                 src="data:image/jpeg;base64,">
                                        </td>
                                        <td width="25%">
                                            <img width="120" height="120"
                                                 src="data:image/jpeg;base64,">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <img class="messeger" width="28" height="28" alt="*"
                                                 src="data:image/jpeg;base64,">
                                            <a href="https://chats.viber.com/dom.ru/ru" class="message_link">Viber</a>
                                        </td>
                                        <td>
                                            <img class="messeger" width="28" height="28" alt="*"
                                                 src="data:image/jpeg;base64,">
                                            <a href="https://t.me/DomruBusinessBot" class="message_link">Telegram</a>
                                        </td>
                                        <td>
                                            <img class="messeger" width="28" height="28" alt="*"
                                                 src="data:image/jpeg;base64,">
                                            <a href="https://wa.me/73422195440" class="message_link">WhatsApp</a>
                                        </td>
                                        <td>
                                            <img class="messeger" width="28" height="28" alt="*"
                                                 src="data:image/jpeg;base64,">
                                            <a href="https://b2b.domru.ru/?openchat" class="message_link">Чат на
                                                сайте</a>
                                        </td>
                                    </tr>
                                </table>
                                <p class="mail-text-title mail-text--bold">${gratitudeUp}</p>
                                <p class="mail-text--translucent mail-text--light-gray">${gratitudeDown?no_esc}</p>
                                <p class="mail-text--translucent mail-text--light-gray">${footerInMassage}${.now?string.yyyy}</p>
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    </body>
    </html>
</#macro>
