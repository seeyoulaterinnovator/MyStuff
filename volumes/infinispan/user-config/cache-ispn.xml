<?xml version="1.0" encoding="UTF-8"?>
<infinispan
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:infinispan:config:15.0 http://www.infinispan.org/schemas/infinispan-config-15.0.xsd"
        xmlns="urn:infinispan:config:15.0">
    <server xmlns="urn:infinispan:server:15.0">
        <interfaces>
            <interface name="public">
                <inet-address value="${infinispan.bind.address:127.0.0.1}"/>
            </interface>
        </interfaces>

        <socket-bindings default-interface="public" port-offset="${infinispan.socket.binding.port-offset:0}">
            <socket-binding name="default" port="${infinispan.bind.port:11222}"/>
        </socket-bindings>

        <security>
            <security-realms>
                <security-realm name="default">
                    <properties-realm/>
                </security-realm>
            </security-realms>
        </security>

        <endpoints socket-binding="default" security-realm="default" />
    </server>

    <jgroups>
        <stack name="custom" extends="tcp">
            <dns.DNS_PING dns_record_type="A"
                          dns_query="infinispan1,infinispan2"
                          stack.combine="REPLACE"
                          stack.position="MPING"/>
        </stack>
    </jgroups>

    <cache-container name="keycloak" statistics="true">
        <transport lock-timeout="60000" stack="custom"/>
        <distributed-cache name="sessions" owners="2" statistics="true">
            <encoding media-type="application/x-jboss-marshalling"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <state-transfer timeout="120000" chunk-size="2048"/>
            <locking acquire-timeout="60000"/>
        </distributed-cache>
        <distributed-cache name="authenticationSessions" owners="2">
            <encoding media-type="application/x-jboss-marshalling"/>
            <expiration lifespan="-1"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <state-transfer timeout="120000" chunk-size="2048"/>
            <locking acquire-timeout="60000"/>
        </distributed-cache>
        <distributed-cache name="offlineSessions" owners="2">
            <encoding media-type="application/x-jboss-marshalling"/>
            <expiration lifespan="-1"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <state-transfer timeout="120000" chunk-size="2048"/>
            <locking acquire-timeout="60000"/>
        </distributed-cache>
        <distributed-cache name="clientSessions" owners="2">
            <encoding media-type="application/x-jboss-marshalling"/>
            <expiration lifespan="-1"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <state-transfer timeout="120000" chunk-size="2048"/>
            <locking acquire-timeout="60000"/>
        </distributed-cache>
        <distributed-cache name="offlineClientSessions" owners="2">
            <encoding media-type="application/x-jboss-marshalling"/>
            <expiration lifespan="-1"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <state-transfer timeout="120000" chunk-size="2048"/>
            <locking acquire-timeout="60000"/>
        </distributed-cache>
        <distributed-cache name="loginFailures" owners="2">
            <encoding media-type="application/x-jboss-marshalling"/>
            <expiration lifespan="-1"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <state-transfer timeout="120000" chunk-size="2048"/>
            <locking acquire-timeout="60000"/>
        </distributed-cache>
        <replicated-cache name="work">
            <encoding media-type="application/x-jboss-marshalling"/>
            <expiration lifespan="-1"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <state-transfer timeout="120000" chunk-size="2048"/>
            <locking acquire-timeout="60000"/>
        </replicated-cache>
        <distributed-cache name="actionTokens" owners="2">
            <encoding media-type="application/x-jboss-marshalling"/>
            <expiration max-idle="-1" lifespan="-1" interval="300000"/>
            <memory max-count="-1"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <state-transfer timeout="120000" chunk-size="2048"/>
            <locking acquire-timeout="60000"/>
        </distributed-cache>
    </cache-container>

    <cache-container name="custom">
        <transport lock-timeout="60000" stack="custom"/>
        <distributed-cache name="customers" statistics="true">
            <encoding media-type="application/x-jboss-marshalling"/>
            <expiration lifespan="30000"/>
            <memory max-count="-1"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <state-transfer timeout="120000" chunk-size="2048"/>
            <locking acquire-timeout="60000"/>
        </distributed-cache>
        <replicated-cache name="locks" statistics="true">
            <encoding media-type="application/x-jboss-marshalling"/>
            <expiration lifespan="-1"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <state-transfer timeout="120000" chunk-size="2048"/>
            <locking acquire-timeout="60000"/>
        </replicated-cache>
    </cache-container>

    <cache-container name="custom">
        <transport lock-timeout="60000" site="sso"/>
        <serialization marshaller="org.infinispan.jboss.marshalling.commons.GenericJBossMarshaller"/>
        <replicated-cache name="user_post_cache">
            <encoding media-type="application/x-jboss-marshalling"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <expiration max-idle="100000" lifespan="500000"/>
            <state-transfer chunk-size="2048" timeout="120000"/>
            <persistence passivation="true"/>
        </replicated-cache>
        <replicated-cache name="customer_cache">
            <encoding media-type="application/x-jboss-marshalling"/>
            <transaction mode="NON_XA" locking="PESSIMISTIC"/>
            <expiration max-idle="100000" lifespan="500000"/>
            <state-transfer chunk-size="2048" timeout="120000"/>
            <persistence passivation="true"/>
        </replicated-cache>
    </cache-container>
</infinispan>
