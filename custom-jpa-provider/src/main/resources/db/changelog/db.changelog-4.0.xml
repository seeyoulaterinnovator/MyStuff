    <!-- 1. Создаём таблицу BRAND -->
    <changeSet id="2025-09-17-1-create-brand" author="vakilev.aa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="BRAND"/>
            </not>
        </preConditions>
        <createTable tableName="BRAND">
            <column name="ID" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CODE" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 2. Создаём таблицу REALM_BRAND -->
    <changeSet id="2025-09-17-2-create-realm-brand" author="vakilev.aa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="REALM_BRAND"/>
            </not>
        </preConditions>
        <createTable tableName="REALM_BRAND">
            <column name="ID" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="BRAND_ID" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="IS_DEFAULT" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

    <!-- 2.1 FK на BRAND -->
    <changeSet id="2025-09-17-2a-fk-brand" author="vakilev.aa">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REALM_BRAND"/>
            <tableExists tableName="BRAND"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_REALM_BRAND_BRAND"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="REALM_BRAND"
                                 baseColumnNames="BRAND_ID"
                                 constraintName="FK_REALM_BRAND_BRAND"
                                 referencedTableName="BRAND"
                                 referencedColumnNames="ID"/>
    </changeSet>

    <!-- 2.2 FK на REALM -->
    <changeSet id="2025-09-17-2b-fk-realm" author="vakilev.aa">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REALM_BRAND"/>
            <tableExists tableName="REALM"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_REALM_BRAND_REALM"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="REALM_BRAND"
                                 baseColumnNames="REALM_ID"
                                 constraintName="FK_REALM_BRAND_REALM"
                                 referencedTableName="REALM"
                                 referencedColumnNames="ID"/>
    </changeSet>

