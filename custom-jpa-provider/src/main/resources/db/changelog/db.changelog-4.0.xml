    <!-- 5. Добавляем поля в USER_LOGIN_HISTORY -->
    <changeSet id="2025-09-17-5-add-brand-to-login-history" author="vakilev.aa">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="USER_LOGIN_HISTORY"/>
            <or>
                <not>
                    <columnExists tableName="USER_LOGIN_HISTORY" columnName="BRAND_ID"/>
                </not>
                <not>
                    <columnExists tableName="USER_LOGIN_HISTORY" columnName="BRAND_NAME"/>
                </not>
            </or>
        </preConditions>
        <addColumn tableName="USER_LOGIN_HISTORY">
            <column name="BRAND_ID" type="CHAR(36)"/>
            <column name="BRAND_NAME" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <!-- 6. Проставляем markBrandId для всех пользователей без бренда -->
    <changeSet id="2025-09-17-6-assign-brand-to-users" author="vakilev.aa">
        <sql>
            INSERT INTO USER_ATTRIBUTE (id, name, value, user_id)
            SELECT UUID(),
                   'markBrandId',
                   rb.BRAND_ID,
                   u.id
            FROM USER_ENTITY u
                     JOIN REALM_BRAND rb ON rb.REALM_ID = u.REALM_ID AND rb.IS_DEFAULT = true
            WHERE NOT EXISTS (SELECT 1
                              FROM USER_ATTRIBUTE a
                              WHERE a.user_id = u.id
                                AND a.name = 'markBrandId');
        </sql>
    </changeSet>

    <!-- 7. Добавляем поле MARK_BRAND_ID для USER_POST -->
    <changeSet id="2025-09-17-7-add-markBrandId-to-user-post" author="vakilev.aa">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="USER_POST"/>
            <not>
                <columnExists tableName="USER_POST" columnName="MARK_BRAND_ID"/>
            </not>
        </preConditions>
        <addColumn tableName="USER_POST">
            <column name="MARK_BRAND_ID" type="CHAR(36)"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="USER_POST"
                                 baseColumnNames="MARK_BRAND_ID"
                                 constraintName="FK_USER_POST_BRAND"
                                 referencedTableName="BRAND"
                                 referencedColumnNames="ID"/>
    </changeSet>

