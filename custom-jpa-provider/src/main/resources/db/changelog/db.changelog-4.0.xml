                                 baseColumnNames="MARK_BRAND_ID"
                                 constraintName="FK_IMPORT_USERS_DATA_BRAND"
                                 referencedTableName="BRAND"
                                 referencedColumnNames="ID"/>
    </changeSet>

    <!-- 9. Обновляем пользователей по списку от BSS -->
    <changeSet id="2025-09-17-9-bss-tomsid-update" author="vakilev.aa" runOnChange="true">
        <sqlFile path="sql/bss-tomsid-update.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 stripComments="true"/>
    </changeSet>

    <!-- 10. Заполняем поле MARK_BRAND_ID для USER_POST -->
    <changeSet id="2025-09-17-10-userpost-brand-sync" author="vakilev.aa">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="USER_POST"/>
            <tableExists tableName="USER_ENTITY"/>
            <tableExists tableName="REALM_BRAND"/>
        </preConditions>
        <sql>
            UPDATE USER_POST up
                JOIN USER_ENTITY ue
            ON up.USER_ID = ue.ID
                JOIN REALM_BRAND rb ON rb.REALM_ID = ue.REALM_ID AND rb.IS_DEFAULT = true
                SET up.MARK_BRAND_ID = rb.BRAND_ID
            WHERE up.MARK_BRAND_ID IS NULL;
        </sql>
    </changeSet>

    <!-- 11. Проставляем MARK_BRAND_ID в IMPORT_USERS_DATA -->
    <changeSet id="2025-09-18-11-import-users-data-brand-sync" author="vakilev.aa">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="IMPORT_USERS_DATA"/>
            <tableExists tableName="USER_ENTITY"/>
            <tableExists tableName="REALM_BRAND"/>
        </preConditions>
        <sql>
            UPDATE IMPORT_USERS_DATA iud
                JOIN USER_ENTITY ue
            ON ue.ID = iud.USER_ID
                JOIN REALM_BRAND rb ON rb.REALM_ID = ue.REALM_ID AND rb.IS_DEFAULT = true
                SET iud.MARK_BRAND_ID = rb.BRAND_ID
            WHERE iud.MARK_BRAND_ID IS NULL;
        </sql>
    </changeSet>

    <!-- 12. Уникальная связка REALM↔BRAND -->
    <changeSet id="2025-09-18-12-uniq-realm-brand" author="vakilev.aa">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REALM_BRAND"/>
            <not>
                <indexExists tableName="REALM_BRAND" indexName="UK_REALM_BRAND_REALM_BRAND"/>
            </not>
        </preConditions>
        <addUniqueConstraint tableName="REALM_BRAND"
                             columnNames="REALM_ID, BRAND_ID"
                             constraintName="UK_REALM_BRAND_REALM_BRAND"/>
    </changeSet>

    <!-- 13. Не более одного дефолтного бренда на REALM -->
    <changeSet id="2025-09-18-13-one-default-per-realm" author="vakilev.aa">
        <preConditions onFail="MARK_RAN">
            <dbms type="mariadb"/>
            <tableExists tableName="REALM_BRAND"/>
            <not>
                <columnExists tableName="REALM_BRAND" columnName="DEFAULT_REALM_UNIQ"/>
            </not>
        </preConditions>
        <sql>
            ALTER TABLE REALM_BRAND
                ADD COLUMN DEFAULT_REALM_UNIQ VARCHAR(64)
                    GENERATED ALWAYS AS (CASE WHEN IS_DEFAULT THEN REALM_ID ELSE NULL END) VIRTUAL,
          ADD UNIQUE INDEX UK_REALM_BRAND_DEFAULT (DEFAULT_REALM_UNIQ);
        </sql>
    </changeSet>
</databaseChangeLog>